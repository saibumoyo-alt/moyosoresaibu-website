/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' https://moyosore-contact-mailer.saibumoyo.workers.dev https://cloudflareinsights.com; form-action 'self' https://moyosore-contact-mailer.saibumoyo.workers.dev; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
/assets/*
  Cache-Control: public, max-age=604800
